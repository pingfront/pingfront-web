{
  "name": "@pingfront/web-widget",
  "version": "1.0.0",
  "description": "pingfront for the web: the in-app chat, pings and moments for web apps, as an npm package and a single script.",
  "type": "module",
  "license": "MIT",
  "author": "pingfront (https://pingfront.sh)",
  "homepage": "https://pingfront.sh/docs/web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pingfront/pingfront-web.git"
  },
  "bugs": {
    "url": "https://github.com/pingfront/pingfront-web/issues"
  },
  "keywords": [
    "pingfront",
    "chat",
    "support chat",
    "in-app messaging",
    "customer support",
    "web push",
    "widget",
    "web component"
  ],
  "sideEffects": [
    "./src/script.ts",
    "./dist/pingfront.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./script": "./dist/pingfront.js",
    "./sw": "./dist/pingfront-sw.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/cdn",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "vite build && vite build --mode script && vite build --mode sw && tsc -p tsconfig.build.json",
    "size": "node scripts/size.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.sw.json",
    "lint": "oxlint --deny-warnings src test example scripts",
    "test": "vitest run",
    "example": "vite --config example/vite.config.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build && pnpm size"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "puppeteer-core": "^25.16.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
